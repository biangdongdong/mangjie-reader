<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mangjie.reader"
    android:versionCode="526"
    android:versionName="1.1.50">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />
    <!-- 点明语音服务：Android 11+ 不声明这句，getPackageInfo 会被包可见性挡成 NameNotFound -->
    <queries>
        <package android:name="com.dianming.phoneapp" />
    </queries>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 后台朗读不被冻结：申请电池优化豁免（小米/OPPO 等还要在系统里把省电策略设为无限制） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Android 11+ 软件包可见性：不声明就查不到系统 TTS 引擎，TextToSpeech 会初始化失败 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- 同上：不声明 VIEW + http/https，Android 11+ 下 resolveActivity 对网页意图恒返回 null，
             订阅单页源会一直判成「没找到浏览器」 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.sunshine.s918" />
    </queries>
    <application android:name=".App" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
            <provider
            android:name=".ApkProvider"
            android:authorities="com.mangjie.reader.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
        <service android:name=".ReadService" android:exported="false"
                 android:foregroundServiceType="mediaPlayback"/>
    </application>
</manifest>
